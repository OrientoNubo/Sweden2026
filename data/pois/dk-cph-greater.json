    {"id": "dk-cph-greater-experimentarium", "name": {"zh": "Experimentarium 互動科學館", "local": "Experimentarium", "en": "Experimentarium"}, "lat": 55.72655, "lng": 12.57996, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-cph-greater", "city": "Hellerup", "category": "museum", "tier": 2, "desc": "Hellerup 的大型互動科學中心,設於舊啤酒瓶裝廠內,有數百件可親手操作的展品、著名的螺旋管樂器樓梯與人體/科學主題展區,是雨天與親子的首選。門票偏貴、以動手體驗為主。含遊玩約 2.5–4 小時。", "stay_min": 150, "stay_max": 240, "url": "https://www.experimentarium.dk", "wikipedia": "https://da.wikipedia.org/wiki/Experimentarium", "image_file": "Experimentarium, Hellerup.jpg", "hours": null, "cost": null, "transit": "S-tog Hellerup 站步行 12 分", "sep_note": null},
    {"id": "dk-cph-greater-frilandsmuseet", "name": {"zh": "丹麥露天博物館", "local": "Frilandsmuseet", "en": "The Open Air Museum"}, "lat": 55.7861, "lng": 12.4923, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "Kongens Lyngby", "category": "museum", "tier": 2, "desc": "丹麥國家博物館旗下的大型露天博物館,占地遼闊,遷建保存了 100 多座 17–19 世紀的農舍、風車與莊園,搭配傳統作物與家畜,重現昔日鄉村生活。腹地大、需大量步行,雨天體驗打折。散步約 2–3 小時。", "stay_min": 120, "stay_max": 180, "url": "https://natmus.dk/museer-og-slotte/frilandsmuseet/", "wikipedia": "https://en.wikipedia.org/wiki/Frilandsmuseet", "image_file": "Frilandsmuseet, 2014-03-15, skråt fra højre.jpg", "hours": null, "cost": null, "transit": "S-tog Sorgenfri 站步行 10 分", "sep_note": null},
    {"id": "dk-cph-greater-arken", "name": {"zh": "方舟現代美術館", "local": "Arken", "en": "Arken Museum of Modern Art"}, "lat": 55.6062, "lng": 12.3876, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "Ishøj", "category": "museum", "tier": 2, "desc": "位於西南郊 Ishøj 海灘沙丘上、外型如擱淺方舟的現代美術館,以粗獷的解構主義船體建築與當代藝術特展著稱,可搭配周邊海灘散步。距市中心較遠、交通約需 40 分鐘。含特展約 1.5–2.5 小時。", "stay_min": 90, "stay_max": 150, "url": "https://arken.dk", "wikipedia": "https://en.wikipedia.org/wiki/Arken_Museum_of_Modern_Art", "image_file": "ARKEN Museum of Modern Art (19174110459).jpg", "hours": null, "cost": null, "transit": "S-tog Ishøj 站轉 Bus 128", "sep_note": null},
