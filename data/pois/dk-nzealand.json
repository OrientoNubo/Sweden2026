    {"id": "dk-nzealand-frederiksborg-slot", "name": {"zh": "腓特烈堡城堡", "local": "Frederiksborg Slot", "en": "Frederiksborg Castle"}, "lat": 55.935, "lng": 12.3012, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-nzealand", "city": "Hillerød", "category": "castle", "tier": 1, "desc": "Hillerød 一座橫跨三座小島、倒映湖面的荷蘭文藝復興城堡,是斯堪地那維亞最大的文藝復興宮殿,現為丹麥國家歷史博物館,金碧輝煌的教堂與大廳令人屏息。庭園採巴洛克對稱設計,城堡與花園值得專程半日。含展覽約 2.5–3.5 小時。", "stay_min": 150, "stay_max": 210, "url": "https://dnm.dk", "wikipedia": "https://en.wikipedia.org/wiki/Frederiksborg_Castle", "image_file": "Frederiksborg Castle and boat crop.jpg", "hours": "4–9 月每日 10:00–17:00", "cost": "成人 125 DKK", "transit": "København H 搭 S-tog 約 40 分至 Hillerød,步行 15 分或搭巴士", "sep_note": null},
