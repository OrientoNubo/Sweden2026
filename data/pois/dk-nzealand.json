    {"id": "dk-nzealand-kronborg", "name": {"zh": "克倫堡", "local": "Kronborg", "en": "Kronborg Castle"}, "lat": 56.0386, "lng": 12.6219, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-nzealand", "city": "Helsingør", "category": "castle", "tier": 1, "desc": "扼守厄勒海峽最窄處的文藝復興要塞王宮,即莎士比亞《哈姆雷特》中的 Elsinore,列名 UNESCO 世界遺產,地窖裡還臥著丹麥傳說英雄 Holger Danske 雕像。宏偉的城堡、城垛與陰森地道值得細看,夏季常有露天《哈姆雷特》演出。含展覽約 2–3 小時。", "stay_min": 120, "stay_max": 180, "url": "https://www.kronborg.dk", "wikipedia": "https://en.wikipedia.org/wiki/Kronborg", "image_file": "Kronborg 002.JPG", "hours": "9 月每日 10:00–17:00", "cost": "成人 150 DKK(線上 135)", "transit": "København H 搭 Kystbanen 火車約 45 分至 Helsingør,步行 12 分", "sep_note": null},
    {"id": "dk-nzealand-ms-museet-for-sofart", "name": {"zh": "丹麥海事博物館", "local": "M/S Museet for Søfart", "en": "Maritime Museum of Denmark"}, "lat": 56.03897, "lng": 12.61616, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-nzealand", "city": "Helsingør", "category": "museum", "tier": 2, "desc": "由 BIG 建築事務所設計、藏於 Kronborg 旁一座舊乾船塢地下的海事博物館,展場沿著挖空的船塢牆環繞而下,建築本身即一大看點,展出丹麥航海與貿易史。空間現代、動線特別,與城堡可一併參觀。約 1.5–2 小時。", "stay_min": 90, "stay_max": 120, "url": "https://mfs.dk", "wikipedia": "https://en.wikipedia.org/wiki/Maritime_Museum_of_Denmark", "image_file": "Danish Maritime Museum exterior.jpg", "hours": "週二–日 11:00–17:00(週一休)", "cost": "成人 135 DKK", "transit": "Helsingør 站步行 10 分(Kronborg 旁)", "sep_note": null},
    {"id": "dk-nzealand-helsingor-gamle-bydel", "name": {"zh": "赫爾辛格老城", "local": "Helsingør gamle bydel", "en": "Helsingør Old Town"}, "lat": 56.03611, "lng": 12.60833, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-nzealand", "city": "Helsingør", "category": "oldtown", "tier": 2, "desc": "Kronborg 城下的老城區,保存大量 15–18 世紀的半木造與磚造老屋、鵝卵石街道與昔日渡海貿易留下的商賈宅邸,如今是餐館、咖啡與小店匯集的散步區。範圍緊湊、氣氛古樸,適合搭配城堡半日遊。散步約 1–1.5 小時。", "stay_min": 60, "stay_max": 90, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Helsing%C3%B8r", "image_file": "Helsingør Elsinore from sea 01.jpg", "hours": "全天開放", "cost": "免費", "transit": "Helsingør 站即達", "sep_note": null},
    {"id": "dk-nzealand-sankt-mariae-kirke", "name": {"zh": "聖瑪利亞教堂(卡爾梅利特修道院)", "local": "Sankt Mariæ Kirke", "en": "St Mary's Church"}, "lat": 56.0368, "lng": 12.6133, "coord_source": "osm", "country": "DK", "region": "dk-nzealand", "city": "Helsingør", "category": "church", "tier": 3, "desc": "老城裡的中世紀磚造教堂,附屬北歐保存最完好的卡爾梅利特修道院(Karmeliterklostret),巴洛克作曲家 Dieterich Buxtehude 曾在此擔任管風琴師。內部樸素肅穆、修道院迴廊值得一看,屬安靜的順訪點。約 20–30 分鐘。", "stay_min": 20, "stay_max": 30, "url": null, "wikipedia": "https://da.wikipedia.org/wiki/Sankt_Mari%C3%A6_Kirke", "image_file": "Sankt Mariæ Kirke (Helsingør) 01.jpg", "hours": null, "cost": "免費", "transit": "Helsingør 站步行 8 分", "sep_note": null},
    {"id": "dk-nzealand-kulturvaerftet", "name": {"zh": "文化船廠", "local": "Kulturværftet", "en": "Culture Yard"}, "lat": 56.03806, "lng": 12.615, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-nzealand", "city": "Helsingør", "category": "landmark", "tier": 3, "desc": "由 Helsingør 舊造船廠改造的玻璃帷幕文化中心,內含圖書館、劇場、咖啡與展覽空間,緊鄰 Kronborg 與海事博物館的碼頭區。以現代建築與海濱景觀為主,可在此歇腳、看海與遠眺瑞典。約 30–45 分鐘。", "stay_min": 30, "stay_max": 45, "url": "https://kuto.dk", "wikipedia": "https://da.wikipedia.org/wiki/Kulturv%C3%A6rftet", "image_file": "Kulturværftet, Helsingør.jpg", "hours": null, "cost": "免費(公共空間)", "transit": "Helsingør 站步行 5 分", "sep_note": null},
    {"id": "dk-nzealand-helsingor-faergehavn", "name": {"zh": "赫爾辛格渡輪碼頭(HH 航線)", "local": "Helsingør Færgehavn", "en": "Helsingør Ferry Harbour"}, "lat": 56.03147, "lng": 12.61301, "coord_source": "osm", "country": "DK", "region": "dk-nzealand", "city": "Helsingør", "category": "transport", "tier": 2, "desc": "厄勒海峽最窄處的丹麥側渡輪碼頭,ForSea 電動渡輪往返對岸瑞典 Helsingborg 僅約 20 分鐘、班次密集,是不經大橋往返兩國的經典路線(瑞典側屬 se-lund-nw)。緊鄰火車站與老城,可安排「搭船看兩岸」的短程體驗。含航程約 30–60 分鐘。", "stay_min": 20, "stay_max": 60, "url": "https://www.forsea.dk", "wikipedia": null, "image_file": "Helsingør færgeterminal 2.jpg", "hours": "渡輪約 20 分一班,幾乎全天運行", "cost": "徒步旅客單程約 69–85 DKK", "transit": "Helsingør 站旁即達碼頭", "sep_note": null},
    {"id": "dk-nzealand-marienlyst-slot", "name": {"zh": "瑪麗恩呂斯特宮", "local": "Marienlyst Slot", "en": "Marienlyst Castle"}, "lat": 56.042, "lng": 12.60194, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-nzealand", "city": "Helsingør", "category": "castle", "tier": 3, "desc": "Helsingør 城北的新古典主義小宮殿,曾是王室避暑別墅,前有法式對稱花園、後望海峽,如今作為在地美術與文物展場。規模小、參觀重點在庭園與從高處看 Kronborg 的視角。約 30–45 分鐘。", "stay_min": 30, "stay_max": 45, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Marienlyst_Castle", "image_file": "Marienlyst Slot.jpg", "hours": null, "cost": null, "transit": "Helsingør 站步行 15 分或搭巴士", "sep_note": null},
    {"id": "dk-nzealand-danmarks-tekniske-museum", "name": {"zh": "丹麥科技博物館", "local": "Danmarks Tekniske Museum", "en": "Danish Museum of Science and Technology"}, "lat": 56.02219, "lng": 12.56253, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-nzealand", "city": "Helsingør", "category": "museum", "tier": 3, "desc": "位於 Helsingør 郊區的大型科技與工業博物館,收藏早期飛機、老爺車、蒸汽機與各式發明,館藏豐富、腹地大,適合親子與機械迷。位置偏郊、需自駕或轉巴士。含步行約 1.5–2.5 小時。", "stay_min": 90, "stay_max": 150, "url": "https://www.tekniskmuseum.dk", "wikipedia": "https://da.wikipedia.org/wiki/Danmarks_Tekniske_Museum", "image_file": "17320 Danmarks Tekniske Museum.jpg", "hours": null, "cost": null, "transit": "Helsingør 站步行 20 分或搭巴士", "sep_note": null},
    {"id": "dk-nzealand-gurre-slot", "name": {"zh": "古勒城堡遺跡", "local": "Gurre Slot", "en": "Gurre Castle"}, "lat": 56.01944, "lng": 12.50528, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-nzealand", "city": "Kvistgård", "category": "history", "tier": 3, "desc": "林間湖畔的中世紀王室城堡遺跡,曾是 Valdemar 四世鍾愛的行宮,如今僅存方形塔基與城牆地基,四周是靜謐的森林與步道。遺跡本身不大、無屋頂建物,適合結合自然散步與傳說想像。約 30–45 分鐘。", "stay_min": 30, "stay_max": 45, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Gurre_Castle", "image_file": "Gurre slot-2007.jpg", "hours": null, "cost": "免費", "transit": "Helsingør 轉巴士或自駕約 15 分", "sep_note": null},
    {"id": "dk-nzealand-louisiana", "name": {"zh": "路易斯安那現代美術館", "local": "Louisiana", "en": "Louisiana Museum of Modern Art"}, "lat": 55.96944, "lng": 12.54306, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-nzealand", "city": "Humlebæk", "category": "museum", "tier": 1, "desc": "座落 Humlebæk 海岸的世界級現代美術館,展館、老別墅與雕塑花園沿坡而下正對厄勒海峽,能一邊看 Calder、Giacometti 一邊眺望對岸瑞典,是丹麥最迷人的美術館體驗。特展精彩、園景一流,是北西蘭必訪。含花園約 2.5–4 小時。", "stay_min": 150, "stay_max": 240, "url": "https://louisiana.dk", "wikipedia": "https://en.wikipedia.org/wiki/Louisiana_Museum_of_Modern_Art", "image_file": "Outside Louisiana Museum of Modern Art.jpg", "hours": "週二–五 10:00–22:00、週六日 10:00–18:00(週一休)", "cost": "成人 145 DKK", "transit": "København H 搭 Kystbanen 火車約 35 分至 Humlebæk,步行 10 分", "sep_note": null},
    {"id": "dk-nzealand-rungstedlund", "name": {"zh": "凱倫·白列森博物館(Rungstedlund)", "local": "Rungstedlund", "en": "Karen Blixen Museum"}, "lat": 55.88333, "lng": 12.54333, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-nzealand", "city": "Rungsted", "category": "museum", "tier": 2, "desc": "《遠離非洲》作者 Karen Blixen 的故居博物館,保存她的書房與家具,四周是她長眠其中的大片鳥類保護林園,可沿步道散步至其墓地。文學迷與園林愛好者的靜謐去處,展區不大、氛圍為重。含花園約 1.5–2 小時。", "stay_min": 90, "stay_max": 120, "url": "https://blixen.dk", "wikipedia": "https://en.wikipedia.org/wiki/Rungstedlund", "image_file": "Rungsted, casa-museo di karen blixen, 02.jpg", "hours": "5–9 月週二–日 10:00–17:00(週一休)", "cost": "成人 100 DKK", "transit": "Kystbanen Rungsted Kyst 站步行 10 分", "sep_note": null},
    {"id": "dk-nzealand-nivaagaards-malerisamling", "name": {"zh": "尼沃郊美術館", "local": "Nivaagaards Malerisamling", "en": "Nivaagaard Collection"}, "lat": 55.92686, "lng": 12.51072, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-nzealand", "city": "Nivå", "category": "museum", "tier": 3, "desc": "Nivå 一座由實業家舊宅改成的小型古典繪畫館,收藏文藝復興到丹麥黃金時代的名作(含林布蘭一幅),館藏精而不多,附庭園與咖啡。規模小、屬順路型美術館,適合搭配 Louisiana 一併安排。約 1–1.5 小時。", "stay_min": 60, "stay_max": 90, "url": "https://nivaagaard.dk", "wikipedia": "https://da.wikipedia.org/wiki/Nivaagaards_Malerisamling", "image_file": "Nivaagaard - museum.JPG", "hours": null, "cost": null, "transit": "Kystbanen Nivå 站步行 15 分", "sep_note": null},
