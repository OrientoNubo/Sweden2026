    {"id": "dk-szealand-mons-klint", "name": {"zh": "默恩崖", "local": "Møns Klint", "en": "Møns Klint"}, "lat": 54.96417, "lng": 12.55222, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-szealand", "city": "Møn", "category": "nature", "tier": 1, "desc": "延綿約 6 公里、高逾 100 公尺的白堊斷崖,綠松色海水映著雪白崖壁,是丹麥最壯觀的自然地標,崖頂山毛櫸林設有多條步道與陡長階梯下到海灘。想下到崖底得走近 500 階、上下頗費腿力。含步道健行約 2–3 小時。", "stay_min": 120, "stay_max": 180, "url": "https://www.moensklint.dk", "wikipedia": "https://en.wikipedia.org/wiki/M%C3%B8ns_Klint", "image_file": "Møns Klint 7.jpg", "hours": null, "cost": "免費", "transit": "Møn 島東端,建議自駕", "sep_note": null},
    {"id": "dk-szealand-geocenter-mons-klint", "name": {"zh": "默恩崖地質中心", "local": "GeoCenter Møns Klint", "en": "GeoCenter Møns Klint"}, "lat": 54.96639, "lng": 12.55083, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-szealand", "city": "Møn", "category": "museum", "tier": 2, "desc": "位於崖頂的互動式地質與自然史博物館,以化石、白堊層與冰河地形展示解說 Møns Klint 的形成,適合親子與雨天備案。門票偏貴、內容以科普為主。約 1–1.5 小時,常與白堊崖健行搭配。", "stay_min": 60, "stay_max": 90, "url": "https://www.moensklint.dk", "wikipedia": "https://en.wikipedia.org/wiki/GeoCenter_M%C3%B8ns_Klint", "image_file": "GeoCenter7.JPG", "hours": null, "cost": null, "transit": "Møns Klint 停車場旁", "sep_note": null},
    {"id": "dk-szealand-liselund", "name": {"zh": "利瑟隆莊園", "local": "Liselund", "en": "Liselund"}, "lat": 55.00028, "lng": 12.52167, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-szealand", "city": "Møn", "category": "park", "tier": 2, "desc": "18 世紀末的浪漫主義小莊園,以白色茅草頂主樓與英式風景庭園聞名,園中有湖泊、瑞士屋與挪威木屋等造景,安徒生曾在此得到童話靈感。主樓僅導覽時段入內,重點在庭園散步。含花園約 1–1.5 小時。", "stay_min": 60, "stay_max": 90, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Liselund", "image_file": "LiselundLystslot.jpg", "hours": null, "cost": "花園免費", "transit": "Møns Klint 附近,建議自駕", "sep_note": null},
    {"id": "dk-szealand-stevns-klint", "name": {"zh": "斯泰溫斯崖", "local": "Stevns Klint", "en": "Stevns Klint"}, "lat": 55.26722, "lng": 12.42333, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-szealand", "city": "Stevns", "category": "coast", "tier": 1, "desc": "列入 UNESCO 世界遺產的白堊海崖,崖壁保存了 6600 萬年前小行星撞擊、恐龍滅絕的黏土層,是地球史關鍵斷面。除地質意義外,沿崖步道與崖上老教堂景致極佳。含步道約 1.5–2 小時。", "stay_min": 90, "stay_max": 120, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Stevns_Klint", "image_file": "Stevns Klint Juli 2019.jpg", "hours": null, "cost": "免費", "transit": "Store Heddinge 近郊,建議自駕", "sep_note": null},
    {"id": "dk-szealand-hojerup-gamle-kirke", "name": {"zh": "霍伊厄魯普老教堂", "local": "Højerup Gamle Kirke", "en": "Højerup Old Church"}, "lat": 55.2791, "lng": 12.44577, "coord_source": "osm", "country": "DK", "region": "dk-szealand", "city": "Stevns", "category": "church", "tier": 2, "desc": "矗立在 Stevns Klint 崖緣的中世紀白牆小教堂,1928 年因崖體崩塌唱詩班席墜海,如今僅存的堂體成為斷崖上的招牌景象。內部樸素、免費開放,是拍崖上教堂的最佳點。約 20–30 分鐘。", "stay_min": 20, "stay_max": 30, "url": null, "wikipedia": null, "image_file": "Stevns Klint - Højerup Gamle Kirke.jpg", "hours": null, "cost": "免費", "transit": "Stevns Klint 遊客中心步行可達", "sep_note": null},
    {"id": "dk-szealand-stevnsfortet", "name": {"zh": "斯泰溫斯堡冷戰博物館", "local": "Stevnsfortet (Koldkrigsmuseum)", "en": "Stevnsfort Cold War Museum"}, "lat": 55.2639, "lng": 12.4115, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-szealand", "city": "Stevns", "category": "history", "tier": 2, "desc": "冷戰時期北約前線的地下要塞,1.7 公里坑道深入石灰岩、配 150 公釐雙聯裝砲塔,如今作為冷戰博物館導覽,是體驗核戰陰影下軍事史的難得場所。坑道恆溫涼冷、需跟導覽團。約 1.5–2 小時。", "stay_min": 90, "stay_max": 120, "url": null, "wikipedia": "https://da.wikipedia.org/wiki/Stevnsfortet", "image_file": "150mm doubleturret stevns.jpg", "hours": null, "cost": null, "transit": "Stevns 半島南端,建議自駕", "sep_note": "部分導覽為季節性,9 月班次較夏季少,建議先查官網時段"},
    {"id": "dk-szealand-koge", "name": {"zh": "克厄", "local": "Køge", "en": "Køge"}, "lat": 55.45611, "lng": 12.17972, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-szealand", "city": "Køge", "category": "oldtown", "tier": 2, "desc": "西蘭島東南岸的古老港市,擁有丹麥保存最完整的半木造老屋群與熱鬧的中央廣場 Torvet,街巷氛圍悠閒,搭 S-tog 一小時可從哥本哈根直達。景點集中、規模不大。老城散步約 1.5–2 小時。", "stay_min": 90, "stay_max": 120, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/K%C3%B8ge", "image_file": "Køge - statue af Frederik 7. - Torvet.jpg", "hours": null, "cost": "免費", "transit": "哥本哈根 S-tog A 線終點,約 40–60 分", "sep_note": null},
