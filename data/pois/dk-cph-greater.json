    {"id": "dk-cph-greater-superkilen", "name": {"zh": "超級線形公園", "local": "Superkilen", "en": "Superkilen"}, "lat": 55.7, "lng": 12.54583, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "København", "category": "park", "tier": 2, "desc": "Nørrebro 移民街區裡由 BIG、Topotek1 與 Superflex 共同打造的都市設計公園,以紅黑白三色分區、蒐羅全球 60 國街道家具(章魚溜滑梯、霓虹招牌、噴泉)拼貼而成,是建築與設計迷的打卡熱點。純戶外景觀、無遮蔽,重點在拍照與感受多元社區氛圍。散步約 30–45 分鐘。", "stay_min": 30, "stay_max": 45, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Superkilen", "image_file": "Superkilen hill-top view.jpg", "hours": null, "cost": "免費", "transit": "Metro Nørrebros Runddel 步行 5 分", "sep_note": null},
    {"id": "dk-cph-greater-assistens-kirkegard", "name": {"zh": "阿西斯滕斯公墓", "local": "Assistens Kirkegård", "en": "Assistens Cemetery"}, "lat": 55.69083, "lng": 12.54944, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-cph-greater", "city": "København", "category": "park", "tier": 2, "desc": "Nørrebro 的歷史墓園,同時是本地人野餐、慢跑、曬太陽的綠地公園,長眠者包括 H.C. Andersen、哲學家 Kierkegaard 與物理學家 Niels Bohr。氛圍靜謐、綠蔭濃密,適合追名人墓與林蔭散步。約 45–60 分鐘。", "stay_min": 45, "stay_max": 60, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Assistens_Cemetery,_Copenhagen", "image_file": "Assistens Kirkegård 1.jpg", "hours": null, "cost": "免費", "transit": "Metro Nørrebros Runddel 步行 3 分", "sep_note": null},
    {"id": "dk-cph-greater-jaegersborggade", "name": {"zh": "耶格斯堡街", "local": "Jægersborggade", "en": "Jægersborggade"}, "lat": 55.69272, "lng": 12.54391, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-cph-greater", "city": "København", "category": "market", "tier": 3, "desc": "Nørrebro 一條約 400 公尺的獨立小店街,聚集手工陶藝、有機咖啡、麵包坊、葡萄酒吧與米其林餐廳 Relæ 系列,是體驗哥本哈根潮流飲食的縮影。街短、以逛店與 fika 為主,無傳統景點。逛吃約 45–60 分鐘。", "stay_min": 45, "stay_max": 60, "url": null, "wikipedia": "https://da.wikipedia.org/wiki/J%C3%A6gersborggade", "image_file": "Jægersborggade.JPG", "hours": null, "cost": "免費", "transit": "Metro Nørrebros Runddel 步行 5 分", "sep_note": null},
    {"id": "dk-cph-greater-kodbyen", "name": {"zh": "肉品加工區", "local": "Kødbyen", "en": "Meatpacking District"}, "lat": 55.6675, "lng": 12.5597, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "København", "category": "market", "tier": 2, "desc": "Vesterbro 由 1930 年代白色屠宰場改造的餐飲夜生活區,聚集海鮮吧、披薩、精釀酒吧、藝廊與夜店,白天安靜、入夜熱鬧。工業風氛圍獨特,週末夜人潮多、部分場所價位偏高。含用餐約 1.5–2 小時。", "stay_min": 60, "stay_max": 120, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/K%C3%B8dbyen", "image_file": "Øksnehallen hovedindgang.jpg", "hours": null, "cost": "免費", "transit": "S-tog Dybbølsbro 步行 5 分", "sep_note": null},
    {"id": "dk-cph-greater-vaernedamsvej", "name": {"zh": "韋訥丹姆斯街", "local": "Værnedamsvej", "en": "Værnedamsvej"}, "lat": 55.6739, "lng": 12.5499, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "København", "category": "market", "tier": 3, "desc": "橫跨 Vesterbro 與 Frederiksberg 交界的美食小街,常被稱為「哥本哈根的小巴黎」,聚集起司舖、酒商、花店與人氣咖啡館。街道短、氣氛悠閒,適合買熟食野餐或喝杯咖啡。約 30–45 分鐘。", "stay_min": 30, "stay_max": 45, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/V%C3%A6rnedamsvej", "image_file": "Værnedamsvej (Copenhagen).jpg", "hours": null, "cost": "免費", "transit": "Metro Frederiksberg Allé 步行 6 分", "sep_note": null},
    {"id": "dk-cph-greater-frederiksberg-have", "name": {"zh": "腓特烈斯貝花園", "local": "Frederiksberg Have", "en": "Frederiksberg Gardens"}, "lat": 55.675, "lng": 12.525, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "Frederiksberg", "category": "park", "tier": 2, "desc": "18 世紀的浪漫主義英式庭園,有運河、瀑布、中國式涼亭與腓特烈斯貝宮居高俯瞰,可搭小船遊園,並能從園內免費望見動物園的大象。是哥本哈根最優雅的城市公園之一,秋季落葉景致佳。散步約 1–1.5 小時。", "stay_min": 60, "stay_max": 90, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Frederiksberg_Gardens", "image_file": "Frederiksberg Have - Palace.jpg", "hours": null, "cost": "免費", "transit": "Metro Frederiksberg 步行 5 分", "sep_note": null},
    {"id": "dk-cph-greater-zoologisk-have", "name": {"zh": "哥本哈根動物園", "local": "Zoologisk Have", "en": "Copenhagen Zoo"}, "lat": 55.67278, "lng": 12.52139, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "Frederiksberg", "category": "themepark", "tier": 2, "desc": "1859 年創立、歐洲最古老的動物園之一,以北極熊館、大象館(Norman Foster 設計)與 44 公尺高的木造觀景塔聞名,適合親子半日行程。門票偏貴、旺季人多。含步行約 2.5–4 小時。", "stay_min": 150, "stay_max": 240, "url": "https://zoo.dk", "wikipedia": "https://en.wikipedia.org/wiki/Copenhagen_Zoo", "image_file": "Copenhagen Zoo Tower and camel.jpg", "hours": null, "cost": null, "transit": "Metro Frederiksberg 步行 15 分或 Bus 26", "sep_note": null},
    {"id": "dk-cph-greater-carlsberg-byen", "name": {"zh": "嘉士伯城區", "local": "Carlsberg Byen", "en": "Carlsberg City District"}, "lat": 55.6661, "lng": 12.5329, "coord_source": "wikidata", "country": "DK", "region": "dk-cph-greater", "city": "København", "category": "landmark", "tier": 3, "desc": "由嘉士伯啤酒舊釀造廠改造的新市區,保留象門(Elefantporten)、Dipylon 門與老磚造廠房,並穿插新建住宅與餐飲,可順道參觀 Home of Carlsberg 品牌體驗館。建築散步免費,啤酒館與體驗館需另購票。逛區約 1–1.5 小時。", "stay_min": 60, "stay_max": 90, "url": "https://www.visitcarlsberg.dk", "wikipedia": "https://en.wikipedia.org/wiki/Carlsberg_(district)", "image_file": "Dipylontårnet, Ny Carlsbergvej.jpg", "hours": null, "cost": "免費(街區)", "transit": "S-tog Carlsberg 站即達", "sep_note": null},
    {"id": "dk-cph-greater-frederiksberg-slot", "name": {"zh": "腓特烈斯貝宮", "local": "Frederiksberg Slot", "en": "Frederiksberg Palace"}, "lat": 55.67167, "lng": 12.525, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "Frederiksberg", "category": "castle", "tier": 3, "desc": "18 世紀初的巴洛克夏宮,矗立於腓特烈斯貝花園的高丘上,現為丹麥皇家軍官學校,內部不對外開放。以外觀與居高的花園景色為主,是拍攝運河與大象館的最佳位置。約 20–30 分鐘。", "stay_min": 20, "stay_max": 30, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Frederiksberg_Palace", "image_file": "Frederiksberg Slot set fra plænen.jpg", "hours": null, "cost": "免費(僅外觀)", "transit": "Metro Frederiksberg 步行 8 分", "sep_note": null},
    {"id": "dk-cph-greater-cisternerne", "name": {"zh": "蓄水池美術館", "local": "Cisternerne", "en": "The Cisterns"}, "lat": 55.66953, "lng": 12.52453, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "Frederiksberg", "category": "experience", "tier": 2, "desc": "位於 Søndermarken 地下、由昔日城市儲水庫改造的沉浸式藝術空間,潮濕陰暗、鐘乳石垂懸的巨大水窖每年委託藝術家做大型裝置,氣氛獨一無二。空間陰冷、須走樓梯下行,展覽單一但震撼。約 45–60 分鐘。", "stay_min": 45, "stay_max": 60, "url": "https://cisternerne.dk", "wikipedia": "https://en.wikipedia.org/wiki/Cisternerne", "image_file": "Søndermarken - Cisternerne.jpg", "hours": null, "cost": null, "transit": "Metro Frederiksberg 步行 10 分", "sep_note": null},
