    {"id": "dk-funen-jutland-trapholt", "name": {"zh": "特拉普霍特美術館", "local": "Trapholt", "en": "Trapholt"}, "lat": 55.49942, "lng": 9.53184, "coord_source": "wikidata", "country": "DK", "region": "dk-funen-jutland", "city": "Kolding", "category": "museum", "tier": 3, "desc": "科靈東郊的現代藝術與設計美術館,聚焦丹麥家具、工藝與繪畫,園區展出 Arne Jacobsen 的度假屋 Kubeflex,戶外雕塑花園面向峽灣。規模中等、設計迷取向。約 1.5–2 小時。", "stay_min": 90, "stay_max": 120, "url": "https://www.trapholt.dk", "wikipedia": null, "image_file": "Trapholt-2004-1.jpg", "hours": null, "cost": null, "transit": "Kolding 市區搭巴士約 15 分", "sep_note": null},
    {"id": "dk-funen-jutland-ribe", "name": {"zh": "里伯", "local": "Ribe", "en": "Ribe"}, "lat": 55.32833, "lng": 8.76222, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Ribe", "category": "oldtown", "tier": 1, "desc": "丹麥最古老的城鎮(約 700 年建城),完整保留中世紀鵝卵石街道、歪斜半木造老屋與夜間打更人巡街傳統,古意在全國數一數二。城區精巧、可慢步一整個下午。老城散步約 1.5–2.5 小時。", "stay_min": 90, "stay_max": 150, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Ribe", "image_file": "RibeVue.jpg", "hours": null, "cost": "免費", "transit": "Esbjerg 或 Bramming 轉火車可達", "sep_note": null},
    {"id": "dk-funen-jutland-ribe-vikingecenter", "name": {"zh": "里伯維京中心", "local": "Ribe VikingeCenter", "en": "Ribe Viking Centre"}, "lat": 55.30891, "lng": 8.76789, "coord_source": "osm", "country": "DK", "region": "dk-funen-jutland", "city": "Ribe", "category": "history", "tier": 2, "desc": "里伯南郊的活體維京歷史園區,依考古重建市集、農莊與長屋,由穿古裝者示範鍛造、織布與戰技,是體驗維京日常的戶外園區。屬季節性營運、需步行,雨天體驗打折。約 2–3 小時。", "stay_min": 120, "stay_max": 180, "url": "https://www.ribevikingecenter.dk", "wikipedia": null, "image_file": "Ribe VikingeCenter house.jpg", "hours": null, "cost": null, "transit": "Ribe 市區南側,建議自駕或搭巴士", "sep_note": "戶外園區為季節性營運,9 月多僅平日或縮短開放,務必先查官網"},
    {"id": "dk-funen-jutland-ribe-domkirke", "name": {"zh": "里伯主教座堂", "local": "Ribe Domkirke", "en": "Ribe Cathedral"}, "lat": 55.3281, "lng": 8.7613, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Ribe", "category": "church", "tier": 2, "desc": "丹麥最古老的主教座堂之一,融合羅曼與哥德風、以萊茵進口的火山凝灰岩砌成,可登「市民塔」俯瞰全城與濕地。堂內有現代藝術家的當代彩窗與壁畫。含登塔約 30–45 分鐘。", "stay_min": 30, "stay_max": 45, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Ribe_Cathedral", "image_file": "Ribe Domkirke (Esbjerg Kommune).ajb.jpg", "hours": null, "cost": null, "transit": "Ribe 老城中心", "sep_note": null},
    {"id": "dk-funen-jutland-vadehavscentret", "name": {"zh": "瓦登海中心", "local": "Vadehavscentret", "en": "Wadden Sea Centre"}, "lat": 55.2957, "lng": 8.6692, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-funen-jutland", "city": "Ribe", "category": "nature", "tier": 2, "desc": "UNESCO 世界遺產瓦登海國家公園的門戶展館,茅草覆頂的得獎建築內解說潮汐、候鳥與生態,並是觀賞秋季椋鳥群飛「黑太陽」(Sort Sol)導覽的出發點。展館+導覽最精采。約 1.5–2 小時。", "stay_min": 90, "stay_max": 120, "url": "https://www.vadehavscentret.dk", "wikipedia": "https://da.wikipedia.org/wiki/Vadehavscentret", "image_file": "Vadehavscentret 03.jpg", "hours": null, "cost": null, "transit": "Ribe 西方約 10 公里,建議自駕", "sep_note": "9 月中下旬進入「黑太陽」椋鳥群飛季,導覽熱門建議先預約"},
    {"id": "dk-funen-jutland-skagen", "name": {"zh": "斯卡恩", "local": "Skagen", "en": "Skagen"}, "lat": 57.71667, "lng": 10.58333, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Skagen", "category": "oldtown", "tier": 1, "desc": "丹麥最北端的漁港小鎮,以黃牆紅瓦白邊的特色老屋、清澈北國光線與 19 世紀「斯卡恩畫派」聞名,夏季是丹麥人的度假聖地。餐飲住宿旺季偏貴、9 月人潮稍退更愜意。老城與港口約 2–3 小時。", "stay_min": 120, "stay_max": 180, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Skagen", "image_file": "Skagen rooftops.jpg", "hours": null, "cost": "免費", "transit": "Frederikshavn 搭 Skagensbanen 火車約 35 分", "sep_note": null},
    {"id": "dk-funen-jutland-grenen", "name": {"zh": "格雷嫩海岬", "local": "Grenen", "en": "Grenen"}, "lat": 57.74389, "lng": 10.6475, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Skagen", "category": "coast", "tier": 1, "desc": "丹麥國土最北端的細長沙嘴,Skagerrak 與 Kattegat 兩海在此相撞、可見兩股浪頭交會的奇景,能一腳踏兩海。從停車場走到尖端約 2 公里,可搭「Sandormen」拖拉機車代步。含往返約 1.5–2 小時。", "stay_min": 90, "stay_max": 120, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Grenen", "image_file": "Skagen aka the skaw northmost point of denmark 6th may 2006.jpg", "hours": null, "cost": "免費", "transit": "Skagen 鎮外,自駕或搭巴士至停車場", "sep_note": "Sandormen 觀光拖拉機車為季節性,9 月仍運行但班次漸減,或步行前往"},
    {"id": "dk-funen-jutland-skagens-museum", "name": {"zh": "斯卡恩博物館", "local": "Skagens Museum", "en": "Skagens Museum"}, "lat": 57.7246, "lng": 10.5973, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Skagen", "category": "museum", "tier": 2, "desc": "收藏「斯卡恩畫派」的重鎮,展出 Anna 與 Michael Ancher、P.S. Krøyer 等畫家捕捉北國光線與漁村生活的名作,是理解此地藝術靈魂的地方。館藏精但規模不大。約 1–1.5 小時。", "stay_min": 60, "stay_max": 90, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Skagens_Museum", "image_file": "Skagens Museum, entrance, 2015-07-28.jpg", "hours": null, "cost": null, "transit": "Skagen 鎮中心,步行可達", "sep_note": null},
