    {"id": "dk-cph-greater-grundtvigs-kirke", "name": {"zh": "管風琴教堂", "local": "Grundtvigs Kirke", "en": "Grundtvig's Church"}, "lat": 55.71658, "lng": 12.53361, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "København", "category": "church", "tier": 2, "desc": "Bispebjerg 區的表現主義磚造教堂(1940 完工),黃磚砌成的巨大西立面模仿管風琴音管,是丹麥現代建築的經典之作。位置離市中心稍遠、內部樸素,但立面與挑高中殿極具震撼力,建築迷必看。約 30 分鐘。", "stay_min": 20, "stay_max": 40, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Grundtvig%27s_Church", "image_file": "Grundtvig’s Church 02 (level and colour adjust).jpg", "hours": null, "cost": "免費", "transit": "Bus 6A 至 Grundtvigs Kirke;或 S-tog Emdrup", "sep_note": null},
    {"id": "dk-cph-greater-kobenhavns-lufthavn", "name": {"zh": "哥本哈根凱斯楚普機場", "local": "Københavns Lufthavn", "en": "Copenhagen Airport (CPH)"}, "lat": 55.61806, "lng": 12.65611, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "Kastrup", "category": "transport", "tier": 1, "desc": "北歐最繁忙的國際機場(代碼 CPH,又稱 Kastrup),多數往返瑞典南部的長途旅客由此進出,Metro M2 與區間車 12 分鐘可達市中心、直達 Malmö/Hyllie 僅約 20 分鐘。是進出厄勒海峽兩岸的關鍵樞紐。轉乘約 20–40 分鐘。", "stay_min": 20, "stay_max": 40, "url": "https://www.cph.dk", "wikipedia": "https://en.wikipedia.org/wiki/Copenhagen_Airport", "image_file": "Copenhagen airport from air.jpg", "hours": null, "cost": null, "transit": "Metro M2 / 區間車直達 CPH Lufthavn 站", "sep_note": null},
    {"id": "dk-cph-greater-amager-strandpark", "name": {"zh": "阿邁厄海灘公園", "local": "Amager Strandpark", "en": "Amager Beach Park"}, "lat": 55.654, "lng": 12.6475, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "København", "category": "coast", "tier": 2, "desc": "2005 年整建、綿延約 4.6 公里的城市海灘與人工島,金色沙灘、潟湖與濱海步道正對厄勒海峽,夏天是哥本哈根人游泳日光浴的首選,Metro 直達交通便利。9 月水溫轉涼、以散步騎車為主。停留 1–2 小時。", "stay_min": 60, "stay_max": 120, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Amager_Strandpark", "image_file": "Amager Strandpark - kite surfers.jpg", "hours": null, "cost": "免費", "transit": "Metro M2 Amager Strand 站步行 5 分", "sep_note": null},
    {"id": "dk-cph-greater-amager-bakke", "name": {"zh": "CopenHill 屋頂滑雪發電廠", "local": "Amager Bakke", "en": "CopenHill"}, "lat": 55.6847, "lng": 12.6206, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-cph-greater", "city": "København", "category": "landmark", "tier": 1, "desc": "BIG 建築事務所設計的垃圾焚化發電廠,屋頂鋪設全年開放的人工滑雪道、跑步徑與 85 公尺攀岩牆,是「享樂永續」概念的世界級地標。可登頂看港灣全景,滑雪/攀岩須另付費預約、屋頂步道免費。含登頂約 1–1.5 小時。", "stay_min": 60, "stay_max": 90, "url": "https://copenhill.dk", "wikipedia": "https://en.wikipedia.org/wiki/Copenhill", "image_file": "Amager Bakke (aerial view).jpg", "hours": null, "cost": "屋頂步道免費;滑雪/攀岩另計", "transit": "距市中心約 5 公里,建議搭巴士或計程車", "sep_note": null},
    {"id": "dk-cph-greater-den-bla-planet", "name": {"zh": "國立丹麥水族館(藍色星球)", "local": "Den Blå Planet", "en": "National Aquarium Denmark"}, "lat": 55.638, "lng": 12.656, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "Kastrup", "category": "themepark", "tier": 2, "desc": "北歐最大的水族館,以旋渦造型的鋁製曲面外殼聞名,館內有海底隧道、鎚頭鯊大缸與亞馬遜雨林區,鄰近機場、適合親子。門票不便宜、假日人潮多。含步行約 2–2.5 小時。", "stay_min": 90, "stay_max": 150, "url": "https://denblaaplanet.dk", "wikipedia": "https://en.wikipedia.org/wiki/National_Aquarium_Denmark", "image_file": "Blue Planet (Copenhagen).jpg", "hours": null, "cost": null, "transit": "Metro M2 Kastrup 站步行 8 分", "sep_note": null},
