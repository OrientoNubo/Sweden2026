    {"id": "dk-funen-jutland-hc-andersens-hus", "name": {"zh": "安徒生博物館", "local": "H.C. Andersens Hus", "en": "Hans Christian Andersen Museum"}, "lat": 55.39955, "lng": 10.3919, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Odense", "category": "museum", "tier": 1, "desc": "圍繞安徒生出生故居打造、2021 年由隈研吾操刀重建的沉浸式博物館,以圓弧建築、花園與聲光裝置帶人走進童話世界,是歐登塞的頭號景點。內容偏藝術體驗、非傳統文物陳列。約 1.5–2 小時。", "stay_min": 90, "stay_max": 120, "url": "https://hcandersenshus.dk", "wikipedia": "https://en.wikipedia.org/wiki/Hans_Christian_Andersen_Museum", "image_file": "Hc-andersens-hus.jpg", "hours": null, "cost": null, "transit": "Odense 老城內,步行可達", "sep_note": null},
    {"id": "dk-funen-jutland-sankt-knuds-kirke", "name": {"zh": "聖克努特主教座堂", "local": "Sankt Knuds Kirke", "en": "St. Canute's Cathedral"}, "lat": 55.3954, "lng": 10.38899, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Odense", "category": "church", "tier": 2, "desc": "歐登塞的哥德式主教座堂,供奉 1086 年遇刺的國王聖克努特,地窖可見其聖髑,堂內金箔祭壇屏是北歐晚期哥德藝術傑作。就在老城中心、免費入內。約 20–30 分鐘。", "stay_min": 20, "stay_max": 30, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/St._Canute%27s_Cathedral", "image_file": "Saint Canute's Cathedral.jpg", "hours": null, "cost": "免費", "transit": "Odense 老城中心", "sep_note": null},
    {"id": "dk-funen-jutland-den-fynske-landsby", "name": {"zh": "菲因村莊", "local": "Den Fynske Landsby", "en": "The Funen Village"}, "lat": 55.36583, "lng": 10.38417, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Odense", "category": "museum", "tier": 2, "desc": "歐登塞南郊的露天民居博物館,搬遷重組數十棟 18–19 世紀菲因鄉間半木造農舍與作坊,夏季有穿古裝的工匠與家畜重現舊農村生活。腹地大、需步行,雨天體驗打折。約 1.5–2 小時。", "stay_min": 90, "stay_max": 120, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/The_Funen_Village", "image_file": "Den Fynske Landsby - bindingsværkshus.jpg", "hours": null, "cost": null, "transit": "Odense 市區搭巴士或短程火車", "sep_note": null},
    {"id": "dk-funen-jutland-egeskov-slot", "name": {"zh": "伊埃斯科城堡", "local": "Egeskov Slot", "en": "Egeskov Castle"}, "lat": 55.17639, "lng": 10.48944, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Kværndrup", "category": "castle", "tier": 1, "desc": "歐洲保存最完好的文藝復興水上城堡(1554),浮於湖面的雙塔紅磚堡體如童話,園區另有大型花園迷宮、老爺車與飛機收藏、樹頂步道。內容豐富適合待半天、門票偏貴。含庭園約 2.5–3.5 小時。", "stay_min": 150, "stay_max": 210, "url": "https://www.egeskov.dk", "wikipedia": "https://en.wikipedia.org/wiki/Egeskov_Castle", "image_file": "Egeskov Slot spejling Edit 2.jpg", "hours": null, "cost": null, "transit": "菲因島中南部,建議自駕", "sep_note": "9 月起部分區域改為週末或縮短開放,建議先查官網日曆"},
    {"id": "dk-funen-jutland-faaborg", "name": {"zh": "福堡", "local": "Faaborg", "en": "Faaborg"}, "lat": 55.1, "lng": 10.23333, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Faaborg", "category": "oldtown", "tier": 3, "desc": "菲因島西南的古雅港鎮,歪斜的鵝卵石巷、老鐘樓與 Faaborg 畫派美術館構成悠閒氛圍,也是通往南菲因群島渡輪的門戶。景點少、以慢步調小鎮風情取勝。老城約 1–1.5 小時。", "stay_min": 60, "stay_max": 90, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Faaborg", "image_file": "Tårngade, Faaborg 2021.jpg", "hours": null, "cost": "免費", "transit": "Odense 搭巴士約 1 小時", "sep_note": null},
    {"id": "dk-funen-jutland-nyborg-slot", "name": {"zh": "尼堡城堡", "local": "Nyborg Slot", "en": "Nyborg Castle"}, "lat": 55.31389, "lng": 10.78778, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Nyborg", "category": "castle", "tier": 2, "desc": "菲因島東岸的中世紀王城,曾是丹麥王國的政治中心與首部憲章 Danehof 集會地,近年大規模修復並新增展館重現皇家生活。就在跨島鐵路門戶旁、順路可訪。含展覽約 1–1.5 小時。", "stay_min": 60, "stay_max": 90, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Nyborg_Slot", "image_file": "Nyborg-Palace.jpg", "hours": null, "cost": null, "transit": "Nyborg 站步行 10 分,西蘭往菲因必經", "sep_note": null},
    {"id": "dk-funen-jutland-aarhus", "name": {"zh": "奧胡斯", "local": "Aarhus", "en": "Aarhus"}, "lat": 56.1572, "lng": 10.2107, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Aarhus", "category": "oldtown", "tier": 1, "desc": "丹麥第二大城,兼具大學城活力與濱海文化,拉丁區(Latinerkvarteret)的窄巷、咖啡館與設計小店是散步精華,河濱酒吧與大教堂串起市中心。景點集中、步行友善,是日德蘭東岸的重鎮。老城散步約 2–3 小時。", "stay_min": 120, "stay_max": 180, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Aarhus", "image_file": "Volden ved aften.JPG", "hours": null, "cost": "免費", "transit": "哥本哈根搭火車約 3 小時", "sep_note": null},
    {"id": "dk-funen-jutland-aros-aarhus-kunstmuseum", "name": {"zh": "ARoS 奧胡斯美術館", "local": "ARoS Aarhus Kunstmuseum", "en": "ARoS Aarhus Art Museum"}, "lat": 56.15389, "lng": 10.19961, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Aarhus", "category": "museum", "tier": 1, "desc": "北歐最大美術館之一,招牌是屋頂那圈由 Olafur Eliasson 打造、可繞行一圈看盡全城的彩虹全景長廊《Your Rainbow Panorama》。館藏橫跨黃金時代到當代,常設與特展俱佳。含彩虹廊約 2–2.5 小時。", "stay_min": 120, "stay_max": 150, "url": "https://www.aros.dk", "wikipedia": "https://en.wikipedia.org/wiki/ARoS_Aarhus_Kunstmuseum", "image_file": "Aros.Arhus.1.jpg", "hours": null, "cost": null, "transit": "市中心,步行可達", "sep_note": null},
    {"id": "dk-funen-jutland-den-gamle-by", "name": {"zh": "老城鎮博物館", "local": "Den Gamle By", "en": "The Old Town Museum"}, "lat": 56.15917, "lng": 10.19083, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Aarhus", "category": "museum", "tier": 1, "desc": "把丹麥各地 75 棟老屋搬來重組的露天城鎮博物館,重現 1864、1927、1974 三個年代的街景、店鋪與住家,有穿古裝的居民互動。沉浸感強、腹地大,是奧胡斯必訪。約 2.5–3.5 小時。", "stay_min": 150, "stay_max": 210, "url": "https://www.dengamleby.dk", "wikipedia": "https://en.wikipedia.org/wiki/Den_Gamle_By", "image_file": "Aarhus Den Gamle By 16.JPG", "hours": null, "cost": null, "transit": "市中心西側,步行 15 分", "sep_note": null},
    {"id": "dk-funen-jutland-moesgaard-museum", "name": {"zh": "莫斯高博物館", "local": "Moesgaard Museum", "en": "Moesgaard Museum"}, "lat": 56.08703, "lng": 10.22628, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Aarhus", "category": "museum", "tier": 1, "desc": "以覆草斜屋頂融入丘陵的考古與人類學博物館,鎮館之寶是保存驚人的鐵器時代「Grauballe 沼澤木乃伊」,展陳設計極具戲劇張力,屋頂草坡本身即打卡點。位於市郊、含往返約 3 小時。", "stay_min": 120, "stay_max": 180, "url": "https://www.moesgaardmuseum.dk", "wikipedia": "https://en.wikipedia.org/wiki/Moesgaard_Museum", "image_file": "Moesgård Museum, New building1.JPG", "hours": null, "cost": null, "transit": "市區搭巴士約 20 分", "sep_note": null},
