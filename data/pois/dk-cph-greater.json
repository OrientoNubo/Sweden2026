    {"id": "dk-cph-greater-kastrup-sobad", "name": {"zh": "卡斯特魯普海水浴場(蝸牛浴場)", "local": "Kastrup Søbad", "en": "Kastrup Sea Bath"}, "lat": 55.64549, "lng": 12.64958, "coord_source": "osm", "country": "DK", "region": "dk-cph-greater", "city": "Kastrup", "category": "experience", "tier": 3, "desc": "阿邁厄海濱一座外型如螺旋(綽號「蝸牛」Sneglen)的木造海水浴場平台,伸入海中、可繞行俯瞰厄勒海峽與跨海大橋,是建築感十足的免費戲水與跳水點。9 月水涼、以拍照散步為主。約 30–45 分鐘。", "stay_min": 30, "stay_max": 45, "url": null, "wikipedia": null, "image_file": "Kastrup Søbad 1.JPG", "hours": null, "cost": "免費", "transit": "Metro M2 Kastrup 站步行 12 分", "sep_note": null},
    {"id": "dk-cph-greater-dyrehaven", "name": {"zh": "耶格斯堡鹿苑", "local": "Dyrehaven", "en": "Jægersborg Deer Park"}, "lat": 55.79139, "lng": 12.56083, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-cph-greater", "city": "Klampenborg", "category": "nature", "tier": 2, "desc": "Klampenborg 的皇家獵鹿森林(11 平方公里),放養約 2000 頭紅鹿與黇鹿,古老橡樹與開闊草原構成 UNESCO 登錄的「圍獵景觀」,可步行或搭馬車遊園。腹地大、需步行,建議搭配 Bakken 與獵人行宮。散步約 1.5–3 小時。", "stay_min": 90, "stay_max": 180, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Dyrehaven", "image_file": "Taarbækport Hus 21-03-06 1.jpg", "hours": null, "cost": "免費", "transit": "S-tog C 線 Klampenborg 站即達北門", "sep_note": "9 月中下旬進入鹿群交配季,雄鹿求偶鳴叫活躍,是觀賞紅鹿的最佳時節"},
    {"id": "dk-cph-greater-bakken", "name": {"zh": "巴肯遊樂園", "local": "Bakken", "en": "Bakken"}, "lat": 55.77611, "lng": 12.57389, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-cph-greater", "city": "Klampenborg", "category": "themepark", "tier": 2, "desc": "位於 Dyrehaven 森林中的 Dyrehavsbakken,自 1583 年營業、號稱世界最古老的遊樂園,以木造雲霄飛車、復古攤位與免費入園著稱,氛圍比 Tivoli 更質樸親民。入園免費、遊具需購券或手環。含遊玩約 2–3 小時。", "stay_min": 90, "stay_max": 180, "url": "https://www.bakken.dk", "wikipedia": "https://en.wikipedia.org/wiki/Bakken", "image_file": "Dyrehavsbakken.jpg", "hours": null, "cost": "入園免費;遊具另計", "transit": "S-tog Klampenborg 站步行 10 分(穿過 Dyrehaven)", "sep_note": "遊樂園季節約至 9 月中下旬結束,造訪前務必確認營業日"},
    {"id": "dk-cph-greater-bellevue-strand", "name": {"zh": "貝勒武厄海灘", "local": "Bellevue Strand", "en": "Bellevue Beach"}, "lat": 55.77778, "lng": 12.59222, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-cph-greater", "city": "Klampenborg", "category": "coast", "tier": 3, "desc": "Klampenborg 的人氣白沙海灘,周邊的藍白條紋救生塔、Bellavista 住宅與 Bellevue 劇院皆出自建築大師 Arne Jacobsen 之手,兼具戲水與設計朝聖價值。夏季擁擠、9 月水涼人少。約 45–90 分鐘。", "stay_min": 45, "stay_max": 90, "url": null, "wikipedia": "https://da.wikipedia.org/wiki/Bellevue_Strand", "image_file": "Zealand 2014-07-19 (14582851850).jpg", "hours": null, "cost": "免費", "transit": "S-tog Klampenborg 站步行 5 分", "sep_note": null},
    {"id": "dk-cph-greater-eremitageslottet", "name": {"zh": "隱廬狩獵行宮", "local": "Eremitageslottet", "en": "Hermitage Hunting Lodge"}, "lat": 55.79528, "lng": 12.57111, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "Klampenborg", "category": "castle", "tier": 3, "desc": "Dyrehaven 鹿苑中央草原(Eremitagesletten)上的洛可可皇家狩獵行宮(1736),白色小宮孤立於開闊草地,四周常見鹿群漫步,是森林散步的最佳目的地。內部不對外開放,以外觀與草原景色為主。約 20–30 分鐘。", "stay_min": 20, "stay_max": 30, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Hermitage_Hunting_Lodge", "image_file": "Eremitage Hunting Lodge Dyrehaven.jpg", "hours": null, "cost": "免費(僅外觀)", "transit": "S-tog Klampenborg 站步行 30–40 分(Dyrehaven 內)", "sep_note": null},
    {"id": "dk-cph-greater-charlottenlund-fort", "name": {"zh": "夏洛滕隆德砲台", "local": "Charlottenlund Fort", "en": "Charlottenlund Fort"}, "lat": 55.74583, "lng": 12.58722, "coord_source": "wikipedia-da", "country": "DK", "region": "dk-cph-greater", "city": "Charlottenlund", "category": "coast", "tier": 3, "desc": "19 世紀末的海岸砲台,如今砲座與土堤環繞的凹地成了露營區,外側緊鄰 Charlottenlund 海灘,可散步看海與登堤俯瞰厄勒海峽。景點性弱,適合海濱單車途中順訪。約 30–45 分鐘。", "stay_min": 30, "stay_max": 45, "url": null, "wikipedia": "https://da.wikipedia.org/wiki/Charlottenlund_Fort", "image_file": "Charlottenlund Fort Haubitz4.jpg", "hours": null, "cost": "免費", "transit": "S-tog Charlottenlund 站步行 15 分", "sep_note": null},
