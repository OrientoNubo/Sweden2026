    {"id": "dk-funen-jutland-lego-house", "name": {"zh": "樂高之家", "local": "LEGO House", "en": "LEGO House"}, "lat": 55.73108, "lng": 9.11494, "coord_source": "osm", "country": "DK", "region": "dk-funen-jutland", "city": "Billund", "category": "themepark", "tier": 1, "desc": "由 BIG 事務所設計、外觀如巨型堆疊積木的體驗館,館內六大彩色遊戲區可自由玩積木、看大師之作,屋頂平台開放免費上去。互動性強、與 Legoland 定位不同。約 2.5–4 小時。", "stay_min": 150, "stay_max": 240, "url": "https://legohouse.com", "wikipedia": null, "image_file": "LEGO house exterior 01.jpg", "hours": null, "cost": null, "transit": "Billund 鎮中心,Legoland 步行約 15 分", "sep_note": null},
    {"id": "dk-funen-jutland-jellingstenene", "name": {"zh": "耶靈石", "local": "Jellingstenene", "en": "Jelling Stones"}, "lat": 55.75667, "lng": 9.41944, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-funen-jutland", "city": "Jelling", "category": "history", "tier": 1, "desc": "列入 UNESCO 世界遺產的兩塊 10 世紀盧恩石碑,大石由「藍牙」哈拉爾王所立、記載丹麥基督教化,被譽為「丹麥的出生證明」,旁有巨大維京墓塚與體驗中心。石碑現罩玻璃保護。含博物館約 1–1.5 小時。", "stay_min": 60, "stay_max": 90, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Jelling_stones", "image_file": "Runesten i Jelling.jpg", "hours": null, "cost": "免費", "transit": "Vejle 搭火車約 15 分", "sep_note": null},
