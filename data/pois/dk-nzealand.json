    {"id": "dk-nzealand-gribskov", "name": {"zh": "格里布森林", "local": "Gribskov", "en": "Gribskov Forest"}, "lat": 55.98333, "lng": 12.3, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-nzealand", "city": "Gribskov", "category": "nature", "tier": 3, "desc": "丹麥面積第四大的森林,環抱 Esrum 湖,古老山毛櫸與橡樹林間縱橫著單車與健行步道,是 UNESCO「北西蘭圍獵景觀」的一部分。腹地遼闊、無單一景點,適合騎車、健行與賞秋葉。半日或依路線 2–4 小時。", "stay_min": 90, "stay_max": 240, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Gribskov", "image_file": "Grib skov.jpg", "hours": null, "cost": "免費", "transit": "近 Gribsø/Kagerup 站;建議自駕", "sep_note": null},
