    {"id": "dk-nzealand-roskilde-domkirke", "name": {"zh": "羅斯基勒主教座堂", "local": "Roskilde Domkirke", "en": "Roskilde Cathedral"}, "lat": 55.64278, "lng": 12.08, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-nzealand", "city": "Roskilde", "category": "church", "tier": 1, "desc": "羅斯基勒的紅磚哥德式主教座堂,是斯堪地那維亞第一座哥德磚造教堂、UNESCO 世界遺產,自 15 世紀起即為丹麥歷代君主的皇家陵寢,內有 40 多位國王與王后的華麗石棺與陵墓禮拜堂。宗教與王室史愛好者必看,需購票入場。約 1–1.5 小時。", "stay_min": 60, "stay_max": 90, "url": "https://www.roskildedomkirke.dk", "wikipedia": "https://en.wikipedia.org/wiki/Roskilde_Cathedral", "image_file": "Roskilde Cathedral aerial crop.jpg", "hours": "9 月週一–六 10:00–17:00、週日 13:00–17:00", "cost": "成人 60 DKK", "transit": "København H 搭區間車約 25 分至 Roskilde,步行 10 分", "sep_note": null},
