    {"id": "dk-cph-greater-kalvebod-faelled", "name": {"zh": "卡爾沃博野地", "local": "Kalvebod Fælled", "en": "Kalvebod Fælled"}, "lat": 55.6, "lng": 12.55, "coord_source": "wikipedia-en", "country": "DK", "region": "dk-cph-greater", "city": "København", "category": "nature", "tier": 3, "desc": "阿邁厄島南端 1940 年代圍海造陸而成的大片自然保護區,草原、樹林與濕地棲息馬鹿與大量鳥類,Metro Vestamager 站一出即達,是城市邊緣難得的荒野。純自然、腹地廣,適合單車與賞鳥。散步約 1–2 小時。", "stay_min": 60, "stay_max": 120, "url": null, "wikipedia": "https://en.wikipedia.org/wiki/Kalvebod_F%C3%A6lled", "image_file": "Kalvebod-panoramic.jpg", "hours": null, "cost": "免費", "transit": "Metro M1 Vestamager 站即達", "sep_note": null},
